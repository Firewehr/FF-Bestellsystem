# Apache/LiteSpeed (z. B. bplaced.de)
# ───────────────────────────────────
# Schützt sensible Dateien vor direktem Aufruf im Browser (<URL>/include/sql.sql).
# PHP-include/require aus Skripten funktioniert unverändert (Dateizugriff, kein HTTP).

# Keine automatischen Ordnerliste (Index)
Options -Indexes

# Datenbank-Dumps/-Skripte, Backups nie per HTTP ausliefern
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|bak|dump|sqlite|sqlite3)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)\.(sql|bak|dump|sqlite|sqlite3)$">
    Order deny,allow
    Deny from all
  </FilesMatch>
</IfModule>

# Repo-Konfig versehentlich hochgeladen → nicht auslesbar
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git/ - [F,L]
  # Authorization-Header an PHP durchreichen (CGI/FastCGI, z. B. für mcp.php)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ─── Performance: GZIP-Komprimierung (mod_deflate) ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Performance: Browser-Caching für statische Assets (mod_expires & mod_headers) ───
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType audio/ogg "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Statische Assets mit Versionierung (?v=...) 1 Jahr cachen
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|ogg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Service Worker und Manifest dürfen niemals aggressiv gecacht werden
  <FilesMatch "(?i)(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
  # HTML-Dateien (z. B. PWA-Shell) immer revalidieren
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Dynamische PHP-Skripte nie im Browser-Cache vorhalten
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# nginx-Anwender analog: deny für ~*\.sql$, plus location ^~ /include/ und ^~ /documentation/
