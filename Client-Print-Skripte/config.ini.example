# ============================================================
# FeuerwehrBestellsystem - Print Client Konfiguration
# ============================================================
# 
# Diese Datei nach "config.ini" kopieren und anpassen!
# 
# Jeder Druck-PC benötigt seine eigene config.ini mit dem
# entsprechenden Print Target (Küche, Schank, Grill, etc.)
#
# ============================================================

[Server]
# URL zum Bestellsystem (ohne Schrägstrich am Ende)
# Gratis-bplaced oft nur HTTP → dann http://… verwenden (kein https://, sonst SSL-Fehler).
url = https://ffobritzberg.bplaced.net

# Geräte-Freischaltung (empfohlen): token LEER lassen.
# Der Client registriert sich beim ersten Start selbst, speichert seinen zufälligen
# Geräte-Token in token_file und zeigt einen Kopplungscode an. Im Admin unter
# Stammdaten -> Druckziele -> Druck-Clients das Gerät mit diesem Code freischalten –
# erst danach wird gedruckt.
# Alternativ: globalen Master-Token (Admin -> Rechnungsdaten) oder einen im Admin
# manuell erzeugten Geräte-Token hier eintragen.
token = 

# Name, unter dem dieser Druck-PC im Admin erscheint (leer = Rechnername)
; device_name = Küche-Laptop

# Datei für den selbst registrierten Geräte-Token (relativ zu diesem Ordner)
; token_file = device_token.txt

# Print Target ID - OPTIONAL. Leer lassen = Druckziel wird zentral im Admin
# (Stammdaten -> Druckziele -> Druck-Clients) zugewiesen und kann dort jederzeit
# umgestellt werden, ohne diesen PC anzufassen. Eine Zuweisung im Admin hat immer Vorrang.
# Wird hier ein Wert eingetragen, dient er nur als Vorschlag bzw. für Clients ohne Zuweisung.
#
# Welches Druckziel dieser PC bedient:
#   11 = Küche
#   12 = Schank
#   13 = Feuerflecken (oder andere benutzerdefinierte)
# Die IDs findest du im Admin unter "Druckziele (Print Targets)"
print_target =

# SSL-Zertifikat prüfen (true = sicher, Standard). Bei CERTIFICATE_VERIFY_FAILED / self-signed: false setzen
# (nur im vertrauenswürdigen Netz; besser ist ein korrektes Zertifikat am Server).
verify_ssl = true

# Wie oft der Server abgefragt wird (in Sekunden)
poll_interval = 3

# Event-Modus (SSE): Ist im Admin "Druck per Event" aktiv, meldet der Server neue Druckjobs sofort
# (print_events.php). poll_interval gilt dann nur noch, solange der Event-Kanal nicht verfügbar ist.
use_events = true
# Sicherheits-Abfrage im Event-Modus (Sekunden), falls ein Event verloren geht.
event_fallback_interval = 30

# Wie viele Einträge aus der Thermo-Warteschlange (printer_jobs) pro Runde nacheinander abgeholt werden.
# Der Server liefert pro Anfrage nur einen Job; ohne diesen Wert würde nur einer pro poll_interval gedruckt.
# Standard 25; auf 1 setzen für altes Verhalten (max. ein Queue-Job pro Wartezyklus).
max_printer_jobs_per_poll = 25

# Heartbeat: wie oft dem Server „Ich lebe noch“ gemeldet wird (Sekunden).
# Verhindert, dass der Dienst als abgestürzt gilt, wenn ein Abruf/Druck mal länger dauert.
# 0 = aus. Empfohlen: 60.
heartbeat_interval = 60

# Name dieses Dienstes für die Anzeige im Admin (z.B. kueche, schank).
# Leer = automatisch target_<print_target> (z.B. target_11)
; service_name = kueche

# Zeitmessungen pro Poll-Runde im Konsolen-Log ausgeben (nur für Fehlersuche).
# Standard false = sauberes Log. Alternativ: Skript mit --verbose starten.
verbose_timings = false


[Drucker]
# Test ohne Drucker: true = nichts drucken, Bon wird in der Konsole angezeigt und
# als .txt/.bin in simulate_dir gespeichert. Der Ablauf (Abholen, Bon-Nr., Rückmeldung
# an den Server) ist identisch zum Echtbetrieb. fail = jeden Druck als Fehler melden.
# Alternativ beim Start: --simulate bzw. --simulate-fail
simulate = false
; simulate_dir = simulated_prints

# === WINDOWS ===
# Exakter Name wie in Windows „Geräte und Drucker“ (Freigabename gleich setzen).
name = Receipt Printer

# Temporäre Datei für Druckdaten
temp_file = C:\POS-Daten\printPOS.txt

# === LINUX ===
# Automatische Suche nach angeschlossenen USB-Thermodruckern (Standard: an).
# Durchsucht /dev/usb/lp* (das sind IMMER USB-Geräte der Klasse "Printer" - reine
# USB-Seriell-Adapter wie FTDI/CH340 tauchen dort nicht auf, da sie /dev/ttyUSB*
# erzeugen). So wird automatisch das richtige Device gefunden, auch wenn sich der
# Drucker nach Ab-/Anstecken unter einem anderen Pfad (lp0, lp1, ...) anmeldet.
# Bei false wird ausschließlich "device"/"devices" unten verwendet.
auto_detect = true

# Vendor-IDs (Komma-getrennt, hex ohne 0x) als Tie-Breaker, falls mehrere USB-Drucker
# gleichzeitig angeschlossen sind. 04b8 = Epson, 067b = Prolific (z.B. USB<->Parallel-
# Adapter, wie er an manchen TM-T88 mit Parallel-Port statt USB hängt).
# Reicht NICHT alleine, um "sicher ein Epson" zu erkennen (Adapter melden ihre eigene
# Vendor-ID, nicht die von Epson) - dient nur zur Auswahl bei mehreren Kandidaten.
usb_vendor_ids = 04b8, 067b

# Manuelles Fallback-Device, falls auto_detect=false ist oder kein passendes
# Device automatisch gefunden wurde.
device = /dev/usb/lp0

# Mehrere manuelle Fallback-Devices (Komma-getrennt), z. B. wenn zwei Modelle angeschlossen sind:
# devices = /dev/usb/lp0, /dev/usb/lp1
devices =


[Einstellungen]
# Name/Kopfzeile des Bons wird im Admin gepflegt:
#   Stammdaten -> Druckziele -> „Bon-Kopf & Fußzeile“ (leer = Vereinsname aus den Rechnungsdaten).
# Ein Eintrag ff_name hier wird nicht mehr verwendet.
#
# Optional: Fußzeile, falls im Admin keine Fußzeile eingetragen ist.
; footer_text = Guten Appetit!
